generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum Role {
  ATHLETE
  COACH
}

enum SubscriptionTier {
  FREE
  PRO
  ELITE
}

enum SessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  SESSION_REMINDER
  SESSION_ASSIGNED
  SESSION_CANCELLED
  SESSION_ACCEPTED
  SESSION_DECLINED
  EXERCISE_ASSIGNED
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  WORKOUT_COMPLETED
  COACH_MESSAGE
  TEST_ASSIGNED
  TEST_RESULT_ADDED
}

enum TestStatus {
  PENDING
  COMPLETED
}

// ── User & Profiles ────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  role         Role
  avatar       String?
  phone        String?

  athleteProfile   AthleteProfile?
  coachProfile     CoachProfile?
  sentRequests     Friendship[]    @relation("Requester")
  receivedRequests Friendship[]    @relation("Addressee")
  notifications    Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model AthleteProfile {
  id    String  @id @default(cuid())
  userId String @unique
  sport  String?
  bio    String?
  goals  String?

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachAthletes         CoachAthlete[]
  bookings              SessionBooking[]
  athleteTests          AthleteTest[]
  customTestAssignments CustomTestAssignment[]
  stravaIntegration     StravaIntegration?

  @@map("athlete_profiles")
}

model CoachProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  sports           String[]
  bio              String?
  specialization   String?
  subscriptionTier SubscriptionTier @default(FREE)
  athleteLimit     Int              @default(5)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachAthletes     CoachAthlete[]
  sessions          Session[]
  workoutTemplates  WorkoutTemplate[]
  tests             Test[]
  athleteTests      AthleteTest[]
  customTests       CustomTest[]
  customTestAssignments CustomTestAssignment[]

  @@map("coach_profiles")
}

model CoachAthlete {
  id        String @id @default(cuid())
  coachId   String
  athleteId String
  addedAt   DateTime @default(now())

  coach   CoachProfile   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([coachId, athleteId])
  @@map("coach_athletes")
}

// ── Workout Templates ──────────────────────────────────────────────────────────

model WorkoutTemplate {
  id              String  @id @default(cuid())
  coachId         String
  name            String
  sport           String?
  sets            Int?
  reps            Int?
  durationSeconds Int?
  restSeconds     Int?
  notes           String?

  coach CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("workout_templates")
}

// ── Sessions & Exercises ───────────────────────────────────────────────────────

model Session {
  id              String        @id @default(cuid())
  coachId         String
  title           String
  sport           String
  description     String?
  location        String?
  scheduledAt     DateTime
  durationMinutes Int
  maxAthletes     Int           @default(10)
  status          SessionStatus @default(SCHEDULED)

  coach     CoachProfile     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  exercises Exercise[]
  bookings  SessionBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Exercise {
  id              String  @id @default(cuid())
  sessionId       String
  name            String
  sets            Int?
  reps            Int?
  durationSeconds Int?
  restSeconds     Int?
  notes           String?
  order           Int     @default(0)
  wodType         String? // AMRAP | FOR_TIME | EMOM | TABATA | MIX — null means no WOD timer

  session  Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  progress WorkoutProgress[]

  @@map("exercises")
}

// ── Bookings & Progress ────────────────────────────────────────────────────────

model SessionBooking {
  id        String        @id @default(cuid())
  sessionId String
  athleteId String
  status    BookingStatus @default(CONFIRMED)
  joinedAt  DateTime      @default(now())

  session       Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete       AthleteProfile    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  progress      WorkoutProgress[]
  workoutResult WorkoutResult?

  @@unique([sessionId, athleteId])
  @@map("session_bookings")
}

model WorkoutProgress {
  id          String    @id @default(cuid())
  bookingId   String
  exerciseId  String
  completed   Boolean   @default(false)
  completedAt DateTime?

  booking  SessionBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([bookingId, exerciseId])
  @@map("workout_progress")
}

model WorkoutResult {
  id               String   @id @default(cuid())
  bookingId        String   @unique
  durationMs       Int
  distanceM        Float?
  avgSpeedKph      Float?
  avgPaceSecPerKm  Float?
  calories         Int?
  laps             Int?
  notes            String?
  rawMetrics       Json?
  stravaActivityId String?
  completedAt      DateTime @default(now())

  booking SessionBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("workout_results")
}

// ── Social ─────────────────────────────────────────────────────────────────────

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@map("friendships")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("notifications")
}

// ── Fitness Tests ──────────────────────────────────────────────────────────────

model Test {
  id          String  @id @default(cuid())
  name        String
  description String?
  sport       String?
  unit        String
  isGlobal    Boolean @default(false)
  coachId     String?

  coach        CoachProfile? @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteTests AthleteTest[]

  createdAt DateTime @default(now())

  @@map("tests")
}

model AthleteTest {
  id          String     @id @default(cuid())
  testId      String
  athleteId   String
  coachId     String
  scheduledAt DateTime?
  notes       String?
  status      TestStatus @default(PENDING)

  test    Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  coach   CoachProfile   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  result  TestResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("athlete_tests")
}

model TestResult {
  id            String   @id @default(cuid())
  athleteTestId String   @unique
  value         Float
  unit          String
  notes         String?
  completedAt   DateTime @default(now())

  athleteTest AthleteTest @relation(fields: [athleteTestId], references: [id], onDelete: Cascade)

  @@map("test_results")
}

// ── Custom (multi-movement) Tests ──────────────────────────────────────────────

model CustomTest {
  id          String  @id @default(cuid())
  coachId     String
  name        String
  description String?
  sport       String?
  unit        String

  coach       CoachProfile           @relation(fields: [coachId], references: [id], onDelete: Cascade)
  movements   CustomTestMovement[]
  assignments CustomTestAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("custom_tests")
}

model CustomTestMovement {
  id              String  @id @default(cuid())
  customTestId    String
  name            String
  sets            Int?
  reps            Int?
  distanceMeters  Float?
  durationSeconds Int?
  notes           String?
  order           Int     @default(0)

  customTest      CustomTest                 @relation(fields: [customTestId], references: [id], onDelete: Cascade)
  movementResults CustomTestMovementResult[]

  @@map("custom_test_movements")
}

model CustomTestAssignment {
  id           String     @id @default(cuid())
  customTestId String
  athleteId    String
  coachId      String
  scheduledAt  DateTime?
  notes        String?
  status       TestStatus @default(PENDING)

  customTest      CustomTest                 @relation(fields: [customTestId], references: [id], onDelete: Cascade)
  athlete         AthleteProfile             @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  coach           CoachProfile               @relation(fields: [coachId], references: [id], onDelete: Cascade)
  result          CustomTestResult?
  movementResults CustomTestMovementResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("custom_test_assignments")
}

model CustomTestResult {
  id           String   @id @default(cuid())
  assignmentId String   @unique
  value        Float
  unit         String
  notes        String?
  completedAt  DateTime @default(now())

  assignment CustomTestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("custom_test_results")
}

// ── Integrations ───────────────────────────────────────────────────────────────

model StravaIntegration {
  id              String   @id @default(cuid())
  athleteId       String   @unique
  stravaAthleteId String
  accessToken     String
  refreshToken    String
  expiresAt       DateTime
  scope           String   @default("")

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("strava_integrations")
}

model CustomTestMovementResult {
  id           String   @id @default(cuid())
  assignmentId String
  movementId   String
  value        Float
  notes        String?
  createdAt    DateTime @default(now())

  assignment CustomTestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  movement   CustomTestMovement   @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, movementId])
  @@map("custom_test_movement_results")
}
