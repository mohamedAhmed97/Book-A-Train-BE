generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum Role {
  ATHLETE
  COACH
}

enum SubscriptionTier {
  FREE
  PRO
  ELITE
}

enum SessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  SESSION_REMINDER
  SESSION_ASSIGNED
  SESSION_CANCELLED
  SESSION_ACCEPTED
  SESSION_DECLINED
  EXERCISE_ASSIGNED
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  WORKOUT_COMPLETED
  COACH_MESSAGE
  TEST_ASSIGNED
  TEST_RESULT_ADDED
}

enum TestStatus {
  PENDING
  COMPLETED
}

// Where a vitals sample came from. HEALTH_CONNECT is the Android system
// aggregator (Samsung Health, Fitbit, Garmin and Wear OS all write into it);
// HEALTH_KIT is its iOS counterpart, fed by the vendor iOS apps of watches
// that pair with iPhone (Fitbit, Garmin, Polar, Amazfit — not Wear OS, which
// can't pair with iPhone at all); WEAR_OS is reserved for a future companion
// app streaming sensors directly off the watch; BLE is a direct sensor link.
enum VitalsProvider {
  HEALTH_CONNECT
  HEALTH_KIT
  WEAR_OS
  /// Sensor paired directly over Bluetooth LE (Heart Rate Service 0x180D) —
  /// chest straps and sports watches in broadcast mode. Brand-agnostic and
  /// genuinely live, unlike the platform aggregators above which deliver on
  /// the vendor app's own sync schedule.
  BLE
  MANUAL
}

// ── User & Profiles ────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  role         Role
  avatar       String?
  phone        String?

  athleteProfile   AthleteProfile?
  coachProfile     CoachProfile?
  sentRequests     Friendship[]    @relation("Requester")
  receivedRequests Friendship[]    @relation("Addressee")
  notifications    Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model AthleteProfile {
  id     String  @id @default(cuid())
  userId String  @unique
  sport  String?
  bio    String?
  goals  String?
  weightKg   Float?
  // Used to derive HR training zones. Falls back to DEFAULT_MAX_HR when unset.
  maxHeartRate Int?

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachAthletes         CoachAthlete[]
  bookings              SessionBooking[]
  athleteTests          AthleteTest[]
  customTestAssignments CustomTestAssignment[]
  stravaIntegration     StravaIntegration?
  watchIntegration      WatchIntegration?
  vitalsSamples         VitalsSample[]
  dailyVitals           DailyVitalsMetric[]

  @@map("athlete_profiles")
}

model CoachProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  sports           String[]
  bio              String?
  specialization   String?
  subscriptionTier SubscriptionTier @default(FREE)
  athleteLimit     Int              @default(5)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachAthletes     CoachAthlete[]
  sessions          Session[]
  workoutTemplates  WorkoutTemplate[]
  tests             Test[]
  athleteTests      AthleteTest[]
  customTests       CustomTest[]
  customTestAssignments CustomTestAssignment[]

  @@map("coach_profiles")
}

model CoachAthlete {
  id        String @id @default(cuid())
  coachId   String
  athleteId String
  addedAt   DateTime @default(now())

  coach   CoachProfile   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([coachId, athleteId])
  @@map("coach_athletes")
}

// ── Workout Templates ──────────────────────────────────────────────────────────

model WorkoutTemplate {
  id              String  @id @default(cuid())
  coachId         String
  name            String
  sport           String?
  sets            Int?
  reps            Int?
  durationSeconds Int?
  restSeconds     Int?
  notes           String?

  coach CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("workout_templates")
}

// ── Sessions & Exercises ───────────────────────────────────────────────────────

model Session {
  id              String        @id @default(cuid())
  coachId         String
  title           String
  sport           String
  description     String?
  location        String?
  scheduledAt     DateTime
  durationMinutes Int
  maxAthletes     Int           @default(10)
  status          SessionStatus @default(SCHEDULED)

  coach     CoachProfile     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  exercises Exercise[]
  bookings  SessionBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Exercise {
  id              String  @id @default(cuid())
  sessionId       String
  name            String
  sets            Int?
  reps            Int?
  durationSeconds Int?
  restSeconds     Int?
  notes           String?
  order           Int     @default(0)
  wodType         String? // AMRAP | FOR_TIME | EMOM | TABATA | MIX — null means no WOD timer

  session  Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  progress WorkoutProgress[]

  @@map("exercises")
}

// ── Bookings & Progress ────────────────────────────────────────────────────────

model SessionBooking {
  id        String        @id @default(cuid())
  sessionId String
  athleteId String
  status    BookingStatus @default(CONFIRMED)
  joinedAt  DateTime      @default(now())

  session       Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete       AthleteProfile    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  progress      WorkoutProgress[]
  workoutResult WorkoutResult?
  vitalsSamples  VitalsSample[]
  vitalsSummary  SessionVitalsSummary?
  metricSummaries SessionMetricSummary[]

  @@unique([sessionId, athleteId])
  @@map("session_bookings")
}

model WorkoutProgress {
  id          String    @id @default(cuid())
  bookingId   String
  exerciseId  String
  completed   Boolean   @default(false)
  completedAt DateTime?

  booking  SessionBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([bookingId, exerciseId])
  @@map("workout_progress")
}

model WorkoutResult {
  id               String   @id @default(cuid())
  bookingId        String   @unique
  durationMs       Int
  distanceM        Float?
  avgSpeedKph      Float?
  avgPaceSecPerKm  Float?
  calories         Int?
  laps             Int?
  notes            String?
  rawMetrics       Json?
  stravaActivityId String?
  completedAt      DateTime @default(now())

  booking SessionBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("workout_results")
}

// ── Social ─────────────────────────────────────────────────────────────────────

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@map("friendships")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("notifications")
}

// ── Fitness Tests ──────────────────────────────────────────────────────────────

model Test {
  id          String  @id @default(cuid())
  name        String
  description String?
  sport       String?
  unit        String
  isGlobal    Boolean @default(false)
  coachId     String?

  coach        CoachProfile? @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteTests AthleteTest[]

  createdAt DateTime @default(now())

  @@map("tests")
}

model AthleteTest {
  id          String     @id @default(cuid())
  testId      String
  athleteId   String
  coachId     String
  scheduledAt DateTime?
  notes       String?
  status      TestStatus @default(PENDING)

  test    Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  coach   CoachProfile   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  result  TestResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("athlete_tests")
}

model TestResult {
  id            String   @id @default(cuid())
  athleteTestId String   @unique
  value         Float
  unit          String
  notes         String?
  completedAt   DateTime @default(now())

  athleteTest AthleteTest @relation(fields: [athleteTestId], references: [id], onDelete: Cascade)

  @@map("test_results")
}

// ── Custom (multi-movement) Tests ──────────────────────────────────────────────

model CustomTest {
  id          String  @id @default(cuid())
  coachId     String
  name        String
  description String?
  sport       String?
  unit        String

  coach       CoachProfile           @relation(fields: [coachId], references: [id], onDelete: Cascade)
  movements   CustomTestMovement[]
  assignments CustomTestAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("custom_tests")
}

model CustomTestMovement {
  id              String  @id @default(cuid())
  customTestId    String
  name            String
  sets            Int?
  reps            Int?
  distanceMeters  Float?
  durationSeconds Int?
  notes           String?
  order           Int     @default(0)

  customTest      CustomTest                 @relation(fields: [customTestId], references: [id], onDelete: Cascade)
  movementResults CustomTestMovementResult[]

  @@map("custom_test_movements")
}

model CustomTestAssignment {
  id           String     @id @default(cuid())
  customTestId String
  athleteId    String
  coachId      String
  scheduledAt  DateTime?
  notes        String?
  status       TestStatus @default(PENDING)

  customTest      CustomTest                 @relation(fields: [customTestId], references: [id], onDelete: Cascade)
  athlete         AthleteProfile             @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  coach           CoachProfile               @relation(fields: [coachId], references: [id], onDelete: Cascade)
  result          CustomTestResult?
  movementResults CustomTestMovementResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("custom_test_assignments")
}

model CustomTestResult {
  id           String   @id @default(cuid())
  assignmentId String   @unique
  value        Float
  unit         String
  notes        String?
  completedAt  DateTime @default(now())

  assignment CustomTestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("custom_test_results")
}

// ── Integrations ───────────────────────────────────────────────────────────────

/// One row per athlete who has linked a watch. The phone app owns the actual
/// device pairing — this only records that the athlete granted us read access
/// and which record types came back granted.
model WatchIntegration {
  id           String         @id @default(cuid())
  athleteId    String         @unique
  provider     VitalsProvider @default(HEALTH_CONNECT)
  deviceName   String?
  deviceModel  String?
  /// Health Connect record types the athlete actually approved, e.g. ["HeartRate","Spo2"].
  grantedTypes String[]
  enabled      Boolean        @default(true)
  lastSyncAt   DateTime?

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("watch_integrations")
}

/// Raw time-series point read off the watch. `bookingId` is set when the sample
/// falls inside a tracked session, null for ambient/daily readings.
///
/// `metric` is an open string, not an enum, so any record type the athlete's
/// watch exposes can be stored without a migration. Keys we know how to present
/// are described in services/metricCatalog.ts; unknown keys are still stored and
/// still reach the coach, they just render generically.
model VitalsSample {
  id         String         @id @default(cuid())
  athleteId  String
  bookingId  String?
  metric     String
  value      Float
  unit       String
  recordedAt DateTime
  source     VitalsProvider @default(HEALTH_CONNECT)
  deviceName String?

  athlete AthleteProfile  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  booking SessionBooking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Watch samples carry exact timestamps, so (athlete, metric, instant) is a
  // natural idempotency key — a retried batch upload can't duplicate rows.
  @@unique([athleteId, metric, recordedAt])
  @@index([bookingId, metric, recordedAt])
  @@index([athleteId, metric, recordedAt])
  @@map("vitals_samples")
}

/// Rolled-up vitals for one completed session. Recomputed on ingest so the
/// coach dashboard never has to aggregate thousands of samples on read.
model SessionVitalsSummary {
  id        String @id @default(cuid())
  bookingId String @unique

  avgHeartRate Int?
  maxHeartRate Int?
  minHeartRate Int?

  // Seconds spent in each HR zone (1 = recovery … 5 = max).
  zone1Sec Int @default(0)
  zone2Sec Int @default(0)
  zone3Sec Int @default(0)
  zone4Sec Int @default(0)
  zone5Sec Int @default(0)

  avgHrvMs           Float?
  avgSpo2            Float?
  minSpo2            Float?
  avgRespiratoryRate Float?
  avgSkinTempC       Float?
  totalCalories      Int?
  totalSteps         Int?
  totalDistanceM     Float?

  sampleCount Int      @default(0)
  computedAt  DateTime @default(now())

  booking SessionBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("session_vitals_summaries")
}

/// Per-session rollup of one metric, for every metric the session captured.
///
/// Sits alongside SessionVitalsSummary rather than replacing it: HR zones are
/// heart-rate-specific logic that doesn't generalise, whereas this table is
/// uniform and open, so a metric nobody anticipated still reaches the coach with
/// a usable summary. All five aggregates are stored so the reader can pick the
/// one that suits the metric without going back to the raw samples.
model SessionMetricSummary {
  id        String @id @default(cuid())
  bookingId String
  metric    String
  unit      String

  min   Float
  max   Float
  avg   Float
  sum   Float
  /// Most recent value in the session — the meaningful one for body metrics.
  last  Float
  count Int

  computedAt DateTime @default(now())

  booking SessionBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, metric])
  @@index([bookingId])
  @@map("session_metric_summaries")
}

/// Daily recovery/readiness value for one metric, independent of any session.
/// Open per-metric rows for the same reason as VitalsSample.metric.
model DailyVitalsMetric {
  id        String   @id @default(cuid())
  athleteId String
  date      DateTime @db.Date
  metric    String
  value     Float
  unit      String

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([athleteId, date, metric])
  @@index([athleteId, date])
  @@map("daily_vitals_metrics")
}

model StravaIntegration {
  id              String   @id @default(cuid())
  athleteId       String   @unique
  stravaAthleteId String
  accessToken     String
  refreshToken    String
  expiresAt       DateTime
  scope           String   @default("")

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("strava_integrations")
}

model CustomTestMovementResult {
  id           String   @id @default(cuid())
  assignmentId String
  movementId   String
  value        Float
  notes        String?
  createdAt    DateTime @default(now())

  assignment CustomTestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  movement   CustomTestMovement   @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, movementId])
  @@map("custom_test_movement_results")
}
